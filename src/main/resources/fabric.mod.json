{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Lists every trade a villager can roll, with vanilla emerald ranges, and breaks the job site until a chosen offer is cheap enough. If the server has Trade Cycling, the list can use that mod's cycle action instead.",
  "authors": [
    "Emilio Schwaiger"
  ],
  "contact": {
    "homepage": "https://github.com/QuarkOS/trade-cycling-automator",
    "sources": "https://github.com/QuarkOS/trade-cycling-automator",
    "issues": "https://github.com/QuarkOS/trade-cycling-automator/issues"
  },
  "license": "MIT",
  "icon": "assets/${id}/icon.png",
  "environment": "*",
  "accessWidener": "${accessWidener}",
  "entrypoints": {
    "main": [
      "dev.quarkos.villagerreroller.server.VillagerRerollerServer"
    ],
    "client": [
      "dev.quarkos.villagerreroller.VillagerReroller"
    ],
    "modmenu": [
      "dev.quarkos.villagerreroller.config.ModMenuIntegration"
    ]
  },
  "depends": {
    "trade_cycling": ">=1.0.0",
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft}",
    "java": "${java}",
    "${fabricApiId}": "*"
  },
  "suggests": {
    "modmenu": "*",
    "trade_cycling": "*"
  }
}
