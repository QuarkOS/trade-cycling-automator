{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Lists every trade a villager can roll, with vanilla emerald ranges, and breaks the job site until a chosen offer is cheap enough.",
  "license": "MIT",
  "environment": "client",
  "accessWidener": "trade-cycling-automator.accesswidener",
  "entrypoints": {
    "client": [
      "dev.tradecycling.automator.TradeCyclingAutomator"
    ],
    "modmenu": [
      "dev.tradecycling.automator.config.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft}",
    "java": "${java}",
    "fabric-api": "*",
    "trade_cycling": "*",
    "cloth-config": "*",
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "parent": "trade_cycling"
    }
  }
}
